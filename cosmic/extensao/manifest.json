{
  "manifest_version": 3,
  "name": "RicePanel ponte",
  "description": "Diz ao RicePanel quais abas do YouTube e do Globoplay estão tocando, com volume e posição, e pausa a aba que o painel assumir.",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://globoplay.globo.com/*",
    "https://*.globo.com/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  }
}
